<Window x:Class="OzzContextGen.WPF.Views.ExcludedFoldersEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i18n="clr-namespace:OzzContextGen.i18n;assembly=OzzContextGen.i18n"
        xmlns:viewmodels="clr-namespace:OzzContextGen.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ExcludedFoldersEditVM}"
        Title="{x:Static i18n:LocalizedStrings.ExcludedFolders}"
        Height="420" Width="440" MinHeight="320" MinWidth="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/CtxGen-Icon.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input row: Add new folder -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Height="26" VerticalContentAlignment="Center" Margin="0,0,8,0"
                     Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Command="{Binding AddCommand}" Padding="12,3" Height="26">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,4,0">
                        <Path Data="{StaticResource plus}" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    </Viewbox>
                    <TextBlock Text="{x:Static i18n:LocalizedStrings.Add}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- List of folders -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2">
            <ListBox ItemsSource="{Binding Folders}"
                     SelectedItem="{Binding SelectedFolder}"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="{StaticResource folder}" Fill="#C8A032"/>
                            </Viewbox>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Bottom row: Reset on the left, Remove / Save / Cancel on the right -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="{x:Static i18n:LocalizedStrings.ResetToDefaults}"
                    Command="{Binding ResetDefaultsCommand}"
                    Padding="10,4"/>

            <Button Content="{x:Static i18n:LocalizedStrings.Remove}"
                    Command="{Binding RemoveCommand}"
                    Padding="12,4" Margin="0,0,8,0"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="{x:Static i18n:LocalizedStrings.OK}"
                        Command="{Binding SaveCommand}"
                        Padding="16,4" Margin="0,0,8,0"
                        FontWeight="SemiBold"/>
                <Button Content="{x:Static i18n:LocalizedStrings.Cancel}"
                        Command="{Binding CancelCommand}"
                        Padding="12,4" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
